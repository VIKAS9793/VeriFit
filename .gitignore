# VeriFit .gitignore
# Generated: 2025-12-28

# ========================================
# Python
# ========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.hypothesis/
.pytest_cache/

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# ========================================
# Node.js / JavaScript / React
# ========================================
# Dependencies
node_modules/
jspm_packages/

# Production build
build/
dist/
.next/
out/

# Testing
coverage/

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# ========================================
# Environment & Secrets
# ========================================
.env
.env.*
!.env.example
secrets/
*.secret
*.key
credentials.json
service-account.json

# ========================================
# IDE / Editor
# ========================================
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Cursor
.cursor/

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# ========================================
# OS
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ========================================
# Project-Specific
# ========================================
# User data (PII protection)
data/uploads/
data/resumes/
data/user_data/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Database files
*.db
*.sqlite
*.sqlite3

# n8n workflows (if containing sensitive data)
n8n/workflows/credentials/

# LangChain/LangGraph cache
.langchain/
.langgraph/

# Model files (too large for git) - ML models only, not code
data/models/
*.pt
*.pth
*.onnx
*.pkl
*.joblib

# Generated reports
reports/generated/

# ========================================
# Documentation Build
# ========================================
docs/_build/
site/

# ========================================
# Never Ignore (Explicitly Tracked)
# ========================================
!.gitkeep
!.env.example
